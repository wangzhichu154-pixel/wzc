# Operator-only environment. No account, live feed, or authority is preconfigured.
IBKR_EXECUTION_MODE=readonly
IBKR_PAPER_ATTESTED=false
IBKR_EXCLUSIVE_ACCOUNT_ATTESTED=false
IBKR_DAY_START_ZERO_PNL_ATTESTED=false
IBKR_STOCK_TRADING_PERMISSION_ATTESTED=false
ITCH_LIVE_SOURCE_ATTESTED=false
IBKR_ACCOUNT=
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=71
IBKR_CON_ID=
IBKR_STATE_DIR=/var/lib/vector-paper
VECTOR_CORE_LIBRARY=/opt/vector/build/libvector_core.so
TRADE_SYMBOL=
ITCH_STOCK_LOCATE=
ITCH_GROUP=
ITCH_PORT=
ITCH_INTERFACE_IP=
ITCH_SOURCE_IP=
ITCH_EXPECTED_SESSION=
ITCH_SESSION_DATE=
# All price/money units are 1/10000 USD. Quantities are integer shares.
PAPER_ORDER_SIZE=1
PAPER_INVENTORY_LIMIT=5
PAPER_MAX_NOTIONAL_UNITS=100000000
PAPER_LOSS_LIMIT_UNITS=250000
PAPER_DRAWDOWN_LIMIT_UNITS=250000
PAPER_PRICE_LOW_UNITS=10000
PAPER_PRICE_HIGH_UNITS=10000000
PAPER_TICK_UNITS=100
PAPER_MARKET_MAX_AGE_MS=1000
ITCH_SOURCE_MAX_AGE_MS=1000
PAPER_ACK_TIMEOUT_MS=10000
PAPER_QUOTE_INTERVAL_MS=500
PAPER_QUOTE_LIFETIME_MS=2000
PAPER_ORDERS_PER_SECOND=2
PAPER_CANCELS_PER_SECOND=5
PAPER_MESSAGES_PER_SECOND=10
PAPER_FEE_PER_SHARE_UNITS=100
PAPER_MIN_FEE_UNITS=10000
# Quoting half-spread cost floor uses full minimum fee for a 1-share partial
# execution: fee/share + min/order + slippage/share + required net edge/share.
# All four components are integers in 0..1000000000; min fee must be > 0.
# Rebates do not reduce this floor. These are assumptions, not profit promises.
PAPER_SLIPPAGE_BUFFER_UNITS=100
PAPER_MIN_NET_EDGE_UNITS=100
# Long-only: borrow/short-sale permission verification is not implemented.
PAPER_ALLOW_SHORT=false
# USD AvailableFunds + SettledCash + BuyingPower must all arrive with End.
PAPER_FUNDS_MAX_AGE_MS=15000
PAPER_FUNDS_REFRESH_MS=5000
# Optional operator-managed approved model registry. Empty means no AI model.
# Setting a path requires full paper approval, real licensed data and exact
# policy matching. It never enables --enable-paper, live, or short permissions.
PAPER_AI_REGISTRY=
PAPER_AI_SIGNAL_TTL_MS=250
PAPER_AI_MIN_EXPECTED_EDGE_BPS=1.0
